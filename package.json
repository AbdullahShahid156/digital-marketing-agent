{
  "name": "hunarmand-punjab-marketing-agent",
  "version": "1.0.0",
  "description": "AI-powered Digital Marketing Project Agent for Hunarmand Punjab Batch-3",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "agent": "tsx src/agent.ts",
    "agent:demo": "tsx src/agent.ts run --mode DEMO_MODE",
    "agent:live": "tsx src/agent.ts run --mode LIVE_MODE",
    "agent:q1": "tsx src/agent.ts run --section Q1",
    "agent:q2": "tsx src/agent.ts run --section Q2",
    "agent:status": "tsx src/agent.ts status",
    "agent:report": "tsx src/agent.ts report",
    "agent:tasks": "tsx src/agent.ts tasks"
  },
  "keywords": [
    "digital-marketing",
    "ai-agent",
    "hunarmand-punjab"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "groq-sdk": "^1.6.0",
    "playwright": "^1.62.1",
    "zod": "^3.22.4"
  }
}
